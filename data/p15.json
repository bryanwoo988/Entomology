   "level": "basic",
   "blocks": [
    {
     "type": "list",
     "items": [
      {
       "zh": "蝗虫，如霹雳州拍到的「猴蝗」",
       "en": "Grasshoppers, such as the monkey grasshopper photographed in Perak",
       "ms": "Belalang, seperti belalang monyet yang dirakam di Perak"
      },
      {
       "zh": "模仿叶子的蝗虫 Systella rafflesii 和拟叶螽",
       "en": "Leaf-mimicking grasshoppers (Systella rafflesii) and leaf katydids (Pseudophyllinae)",
       "ms": "Belalang penyamar daun (Systella rafflesii) dan katidid daun (Pseudophyllinae)"
      },
      {
       "zh": "蟋蟀，如雪兰莪州的卷叶蟋蟀；蝼蛄",
       "en": "Crickets, such as the leaf-rolling cricket in Selangor; mole crickets",
       "ms": "Cengkerik, seperti cengkerik penggulung daun di Selangor; anjing tanah"
      }
     ],
     "src": [
      "WTK:5",
      "TJ:75"
     ]
    }
   ]
