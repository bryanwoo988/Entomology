   "level": "basic",
   "blocks": [
    {
     "type": "p",
     "text": {
      "zh": "{{t:odonata}}来自希腊文 odous（牙齿），指它们有齿的大颚。它们是空中的捕食者。",
      "en": "{{t:odonata}} comes from the Greek odous (tooth), after their toothed jaws. They are hunters of the air.",
      "ms": "{{t:odonata}} berasal daripada bahasa Yunani odous (gigi), merujuk rahangnya yang bergigi. Ia pemburu di udara."
     },
     "defines": [
      "odonata"
     ],
     "src": [
      "LSJ"
     ]
    },
    {
     "type": "note",
     "kind": "key",
     "text": {
      "zh": "「牙齿」：有齿的大颚，空中的猎人。",
      "en": "Think 'tooth': toothed jaws, a hunter on the wing.",
      "ms": "Ingat 'gigi': rahang bergigi, pemburu di udara."
     },
     "src": [
      "LSJ"
     ]
    },
    {
     "type": "list",
     "items": [
      {
       "zh": "复眼很大，触角短得几乎看不见",
       "en": "Huge compound eyes; tiny bristle-like antennae",
       "ms": "Mata majmuk sangat besar; sesungut sangat pendek"
      },
      {
       "zh": "两对膜质翅，翅脉很密",
       "en": "Two pairs of membranous, densely veined wings",
       "ms": "Dua pasang sayap bermembran dengan urat yang padat"
      },
      {
       "zh": "若虫（稚虫）在水中生活",
       "en": "The nymphs (naiads) live in water",
       "ms": "Nimfa (naiad) hidup dalam air"
      }
     ],
     "src": [
