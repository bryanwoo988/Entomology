       },
       "v": {
        "zh": "不完全变态（卵→若虫→成虫）",
        "en": "Incomplete (egg → nymph → adult)",
        "ms": "Tidak lengkap (telur → nimfa → dewasa)"
       }
      },
      {
       "k": {
        "zh": "口器",
        "en": "Mouthparts",
        "ms": "Bahagian mulut"
       },
       "v": {
        "zh": "成虫口器退化，不进食",
        "en": "Adults have reduced mouthparts and do not feed",
        "ms": "Dewasa mempunyai bahagian mulut yang tidak berfungsi dan tidak makan"
       }
      }
     ]
    }
   ]
  },
