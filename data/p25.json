     ]
    },
    {
     "type": "note",
     "kind": "key",
     "text": {
      "zh": "「衣鱼」：银色的小鱼，在书堆里游。",
      "en": "Think 'silver fish': a little silver swimmer in your books.",
      "ms": "Ingat 'ikan perak': perenang perak kecil di celah buku."
     },
     "src": [
      "LSJ",
      "WTK:10"
     ]
    },
    {
     "type": "list",
     "items": [
      {
       "zh": "没有翅，身体扁长，常有银灰色鳞片",
       "en": "Wingless, flat and long, often with silvery scales",
       "ms": "Tidak bersayap, leper dan panjang, sering bersisik keperakan"
      },
      {
       "zh": "触角很长",
       "en": "Long antennae",
       "ms": "Sesungut panjang"
      },
      {
       "zh": "尾端有三条长丝",
       "en": "Three long tail threads",
       "ms": "Tiga ekor panjang"
      }
     ],
