   },
   "level": "basic",
   "blocks": [
    {
     "type": "list",
     "items": [
      {
       "zh": "蝴蝶：如粉蝶、蛱蝶、小灰蝶",
       "en": "Butterflies: whites, brush-foots, blues",
       "ms": "Rama-rama: putih, kaki berus, biru"
      },
      {
       "zh": "蛾：如灯蛾、夜蛾、袋蛾",
       "en": "Moths: tiger moths, owlet moths, bagworms",
       "ms": "Kupu-kupu: kupu-kupu harimau, kupu-kupu malam, ulat bungkus"
      },
      {
       "zh": "弄蝶：身体粗壮多毛",
       "en": "Skippers: stout, hairy bodies",
       "ms": "Rama-rama skipper: badan tegap berbulu"
      }
     ],
