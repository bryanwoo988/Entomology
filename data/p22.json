   "level": "basic",
   "blocks": [
    {
     "type": "p",
     "text": {
      "zh": "{{t:neuroptera}}来自希腊文 neuron（筋、脉）加 pteron（翅），指翅上密密麻麻像网一样的翅脉。",
      "en": "{{t:neuroptera}} comes from the Greek neuron (sinew, vein) and pteron (wing), after the dense net of wing veins.",
      "ms": "{{t:neuroptera}} berasal daripada bahasa Yunani neuron (urat) dan pteron (sayap), merujuk jaringan urat sayap yang padat."
     },
     "defines": [
      "neuroptera"
     ],
     "src": [
      "LSJ"
     ]
    },
    {
     "type": "gallery",
     "ids": [
      "lacewing-mallada"
     ]
    },
    {
     "type": "note",
     "kind": "key",
     "text": {
      "zh": "「脉」就是翅脉：翅像一张透明的网。",
      "en": "Think 'veins': each wing is a clear net.",
      "ms": "Ingat 'urat': setiap sayap seperti jaring jernih."
     },
     "src": [
      "LSJ"
     ]
    },
    {
     "type": "list",
     "items": [
      {
       "zh": "两对透明的翅，翅脉多如网",
       "en": "Two pairs of clear wings with net-like veins",
       "ms": "Dua pasang sayap jernih dengan urat seperti jaring"
      },
      {
       "zh": "身体柔软，最长约 50 毫米",
       "en": "Soft body, up to about 50 mm long",
       "ms": "Badan lembut, sehingga kira-kira 50 mm panjang"
      },
      {
       "zh": "触角丝状或末端膨大",
       "en": "Antennae thread-like or clubbed",
       "ms": "Sesungut seperti benang atau berbonjol"
      }
     ],
     "src": [
      "WTK:11"
     ]
    }
   ]
  },
